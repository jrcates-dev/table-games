# Supabase — entirely optional.
#
# With these unset the game runs as a guest against browser local storage:
# bankroll, statistics, hand history and a device-local leaderboard all work.
# Set them to enable sign-in, cloud saves and the global leaderboard.
#
# Copy this file to `.env.local` and fill in the values from
# Supabase dashboard -> Project settings -> API.
# Apply `supabase/schema.sql` first.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
